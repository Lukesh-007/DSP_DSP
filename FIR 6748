// High Pass Filter Program

#include <stdio.h>
#include <math.h>
#define PI 3.1415
int n, N, wc, t;
float wr[64], hp[64], h[64];

void main()
{
    printf("Enter no. of samples N = ");
    scanf("%d", &N);

    printf("Enter cutoff frequency wc = ");
    scanf("%d", &wc);

    printf("Elements of window function are:\n");

    t = (N - 1) / 2;
 // Hamming Window
    for(n = 0; n <= N - 1; n++)
    {
        wr[n] = (0.54) - ((0.46) * cos((2 * PI * n) / (N - 1)));

        printf("\nwr[%d] = %f", n, wr[n]);
    }
 printf("\n\nElements of filter function are:\n");
   // Ideal High Pass Filter
    for(n = 0; n <= N - 1; n++)
    {
        if(n == t)
        {
            hp[n] = 1 - (wc / PI);
        }
        else
        {
            hp[n] = (sin(PI * (n - t)) - sin(wc * (n - t))) /
                    (PI * (n - t));
        }
  printf("\nhp[%d] = %f", n, hp[n]);
    }
printf("\n\nElements of h(n) are:\n");
// Final Filter Coefficients
    for(n = 0; n <= N - 1; n++)
    {
        h[n] = wr[n] * hp[n];
   printf("\nh[%d] = %f", n, h[n]);
    }
}









